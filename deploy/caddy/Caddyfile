# Address-only site blocks (no hostname) below need on-demand TLS to issue
# a certificate for whatever SNI/IP a client connects with; without this,
# Caddy refuses unrecognized names and the handshake fails with a TLS
# internal_error alert instead of serving anything. Safe here because the
# issuer is the internal (self-signed) CA, not rate-limited public ACME.
# This Caddy version only accepts an "ask" policy (no interval/burst), so
# it checks against a loopback-only endpoint below that always allows.
{
    on_demand_tls {
        ask http://localhost:9081/allow-tls
    }
}

# Loopback-only responder for the on_demand_tls ask check above. Not
# published by compose (only 9443/9444 are), so it's unreachable from
# outside the container.
http://localhost:9081 {
    respond /allow-tls 200
}

# External clients connect by IP or a real hostname, not literally
# "localhost" — a hostname-scoped block (https://localhost:9443) only
# answers TLS for that exact SNI and drops everything else.
:9443 {
    tls internal {
        on_demand
    }
    reverse_proxy https://server:8080 {
        transport http {
            # The upstream certificate is generated by the application for
            # development. Caddy still terminates a separate local TLS
            # certificate for browser clients.
            tls_insecure_skip_verify
        }
    }
}

# The admin app emits root-relative redirects and asset links ("/", "/js/..."),
# so it isn't safe to mount under a path prefix on the same listener (a
# handle_path /admin* block breaks navigation past the login redirect). A
# dedicated port avoids that entirely.
:9444 {
    tls internal {
        on_demand
    }
    reverse_proxy https://server:3333 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}
