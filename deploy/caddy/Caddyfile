https://localhost:9443 {
    tls internal
    reverse_proxy https://server:8080 {
        transport http {
            # The upstream certificate is generated by the application for
            # development. Caddy still terminates a separate local TLS
            # certificate for browser clients.
            tls_insecure_skip_verify
        }
    }
}

# The admin app emits root-relative redirects and asset links ("/", "/js/..."),
# so it isn't safe to mount under a path prefix on the same listener (a
# handle_path /admin* block breaks navigation past the login redirect). A
# dedicated port avoids that entirely.
https://localhost:9444 {
    tls internal
    reverse_proxy https://server:3333 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}
